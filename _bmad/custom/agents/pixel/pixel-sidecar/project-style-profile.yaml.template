# Project Style Profile Template
# This file is auto-generated by *analyze-project command
# Manual edits are preserved on re-analysis

project: "PROJECT_NAME"
analyzed_at: "TIMESTAMP"
source_files:
  - "path/to/analyzed/files"

# Color Palette (extracted from CSS/Tailwind)
colors:
  primary: "#000000"
  secondary: "#000000"
  accent: "#000000"
  background: "#ffffff"
  surface: "#f5f5f5"
  text_primary: "#000000"
  text_muted: "#666666"

# Additional colors discovered
color_palette:
  # - name: "color-name"
  #   hex: "#000000"
  #   usage: "where it's used"

# Typography
typography:
  heading_font: "system-ui"
  body_font: "system-ui"
  mono_font: "monospace"
  style: "clean, modern"

# Visual Patterns
visual_patterns:
  corners: "rounded"          # sharp | rounded | pill
  corner_radius: "8px"        # specific value if detected
  shadows: "subtle"           # none | subtle | medium | dramatic
  shadow_style: ""            # specific shadow description
  gradients: false            # true | false
  gradient_style: ""          # description if gradients used
  borders: "subtle"           # none | subtle | prominent
  border_style: ""            # specific border description

# Overall Mood & Aesthetic
mood:
  overall: "professional"
  keywords:
    - "modern"
    - "clean"
  imagery_style: "minimalist"

# Generation Hints (natural language guidance for AI)
generation_hints: |
  [Auto-generated hints based on analysis]

  Example:
  - Use clean, minimalist compositions
  - Prefer light backgrounds with subtle shadows
  - Include modern, geometric elements
  - Maintain professional, corporate feel

# Manual Overrides (user can add custom rules)
manual_overrides:
  # Add any manual style rules here
  # These take precedence over auto-detected values
  # Example:
  # always_include: "subtle grain texture"
  # never_use: "bright neon colors"
