{
  "name": "contextor-vscode",
  "displayName": "Contextor - Prompt Analytics",
  "description": "Track, analyze, and improve your AI prompting skills. Real-time analytics dashboard with 5-dimension scoring, personalized coaching tips, and team insights - all directly in VS Code.",
  "version": "0.1.0",
  "publisher": "ideajetlab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IDEA-JET-LAB/context-coach"
  },
  "homepage": "https://contextor.co",
  "bugs": {
    "url": "https://github.com/IDEA-JET-LAB/context-coach/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "preview": true,
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/ideajetlab.contextor-vscode",
      "href": "https://marketplace.visualstudio.com/items?itemName=ideajetlab.contextor-vscode",
      "description": "Version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/ideajetlab.contextor-vscode",
      "href": "https://marketplace.visualstudio.com/items?itemName=ideajetlab.contextor-vscode",
      "description": "Installs"
    }
  ],
  "qna": "https://github.com/IDEA-JET-LAB/context-coach/discussions",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Education",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "claude",
    "prompt",
    "analytics",
    "coaching",
    "llm",
    "gpt",
    "copilot",
    "productivity",
    "ai-assistant"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onView:contextor.analyticsView",
    "onView:contextor.sessionView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextor",
          "title": "Contextor",
          "icon": "images/contextor-icon.svg"
        }
      ]
    },
    "views": {
      "contextor": [
        {
          "type": "webview",
          "id": "contextor.analyticsView",
          "name": "Analytics"
        },
        {
          "id": "contextor.sessionView",
          "name": "Sessions",
          "when": "contextor.authenticated"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "contextor.analyticsView",
        "contents": "Welcome to Contextor!\n\nTrack and improve your AI prompting skills.\n\n[Sign In](command:contextor.signIn)",
        "when": "!contextor.authenticated"
      }
    ],
    "commands": [
      {
        "command": "contextor.showAnalytics",
        "title": "Contextor: Show Analytics"
      },
      {
        "command": "contextor.showSettings",
        "title": "Contextor: Show Settings"
      },
      {
        "command": "contextor.signIn",
        "title": "Contextor: Sign In"
      },
      {
        "command": "contextor.signOut",
        "title": "Contextor: Sign Out"
      }
    ],
    "configuration": {
      "title": "Contextor",
      "properties": {
        "contextor.apiEndpoint": {
          "type": "string",
          "default": "https://contextor.co/api",
          "description": "API endpoint URL for Contextor service. Change for self-hosted installations.",
          "format": "uri"
        },
        "contextor.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 15,
          "maximum": 300,
          "description": "Analytics auto-refresh interval in seconds (minimum 15)."
        },
        "contextor.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification messages for successful operations."
        },
        "contextor.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show Contextor score in the status bar."
        },
        "contextor.autoRefreshEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic refresh of analytics data."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "build:dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:webview": "cd webviews/analytics && npm run build",
    "build:all": "npm run build:webview && npm run build",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  }
}
