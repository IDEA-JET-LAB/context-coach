# Source files (bundled into dist)
src/**

# Webview source and dev files (keep only compiled dist)
webviews/**/src/**
webviews/**/node_modules/**
webviews/**/package*.json
webviews/**/tsconfig.json
webviews/**/vite.config.ts
webviews/**/index.html
!webviews/analytics/dist/**

# Config files
.vscode/**
.eslintrc*
tsconfig.json
vite.config.ts
jest.config.js

# Development scripts
scripts/**

# Development files
*.map
.gitignore
**/*.ts
**/*.tsx
!dist/**/*.d.ts

# Build artifacts
node_modules/**
*.vsix

# Test files
**/*.test.ts
**/__tests__/**

# Documentation (allow README, CHANGELOG, LICENSE only)
*.md
!README.md
!CHANGELOG.md
!LICENSE

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/**
*.swp
*.swo

# Root node_modules
**/node_modules/**
