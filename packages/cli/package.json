{
  "name": "@contextor/cli",
  "version": "0.1.0",
  "description": "CLI for installing Contextor in your projects",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "contextor": "./dist/bin/contextor.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/bin/contextor.js 2>/dev/null || true",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "contextor",
    "cli",
    "prompt",
    "capture",
    "claude-code"
  ],
  "author": "Contextor",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
